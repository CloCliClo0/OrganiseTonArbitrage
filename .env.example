# Copiez ce fichier en ".env" et remplissez les valeurs réelles.
# Le fichier .env ne doit JAMAIS être commité (déjà ignoré par .gitignore).

# --- Application ---
APP_ENV=production
# development = messages d'erreur plus détaillés, production = les masque
PORT=3000
# URL publique du site, utilisée pour construire les liens dans les emails
# (ex: lien de validation d'email). Sans cette variable, on retombe sur
# l'hôte de la requête, moins fiable derrière un proxy.
APP_URL=https://votre-domaine.fr
# Secret de signature des sessions (cookie JWT). Générez une vraie valeur aléatoire, par ex. :
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-moi-avec-une-vraie-valeur-aleatoire

# --- Base de données ---
# Si APP_ENV=production, l'app se connecte à DB_PROD_* ; sinon à DB_TEST_*.
DB_HOST=localhost

DB_TEST_NAME=organise_ton_arbitrage_test
DB_TEST_USER=root
DB_TEST_PASS=

DB_PROD_NAME=organise_ton_arbitrage
DB_PROD_USER=root
DB_PROD_PASS=

# --- Codes d'inscription staff ---
# Saisis dans le champ "code d'invitation" du formulaire d'inscription
# pour obtenir automatiquement le rôle correspondant. Laisser vide = désactivé.
CODE_ADMIN=change-moi-code-admin
CODE_COACH=change-moi-code-coach
SUPER_ADMIN_EMAIL=admin@example.com

# --- SMTP (envoi d'emails) ---
# Exemple avec Gmail : host=smtp.gmail.com, port=587, secure=tls,
# user=votre-adresse@gmail.com, pass=mot de passe d'application (pas le mdp du compte)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=smtp-user@example.com
SMTP_PASS=change-moi
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=PlannifierMonArbitrage

# --- Rappels automatiques (cron) ---
# Nombre de jours avant la date pour envoyer le rappel au joueur
REMINDER_DAYS_BEFORE=3
# Jeton requis pour déclencher cron_reminders.js par HTTP (sinon utiliser le CLI : node cron_reminders.js)
CRON_SECRET=change-moi-secret-cron
