# Copiez ce fichier en ".env" et remplissez les valeurs réelles.
# Le fichier .env ne doit JAMAIS être commité (déjà ignoré par .gitignore).

# --- Application ---
APP_ENV=production
# development = affiche les erreurs PHP en clair, production = les masque

# --- Base de données ---
DB_HOST=localhost
DB_NAME=organise_ton_arbitrage
DB_USER=root
DB_PASS=

# --- Codes d'inscription staff ---
# Saisis dans le champ "code d'invitation" du formulaire d'inscription
# pour obtenir automatiquement le rôle correspondant. Laisser vide = désactivé.
CODE_ADMIN=change-moi-code-admin
CODE_COACH=change-moi-code-coach
SUPER_ADMIN_EMAIL=admin@example.com

# --- SMTP (envoi d'emails) ---
# Exemple avec Gmail : host=smtp.gmail.com, port=587, secure=tls,
# user=votre-adresse@gmail.com, pass=mot de passe d'application (pas le mdp du compte)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=smtp-user@example.com
SMTP_PASS=change-moi
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=PlannifierMonArbitrage

# --- Rappels automatiques (cron) ---
# Nombre de jours avant la date pour envoyer le rappel au joueur
REMINDER_DAYS_BEFORE=3
# Jeton requis pour déclencher api/cron_reminders.php par HTTP (sinon utiliser le CLI)
CRON_SECRET=change-moi-secret-cron
